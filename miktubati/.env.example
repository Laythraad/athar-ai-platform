# ─── Supabase ───────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for admin/moderation writes.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Roles ──────────────────────────────────────────────────
# The single main admin. Admin is granted ONLY to this email AND only
# once the email is verified. Enforced server-side, never from client state.
ADMIN_EMAIL=laythraadraheem@gmail.com

# ─── AI moderation (Google Gemini) ──────────────────────────
# Server-side only. If unset, the pipeline FAILS CLOSED: content stays
# pending_review and is routed to the human moderator queue.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ATHAR_URL=../site/index.html
