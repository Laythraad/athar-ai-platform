# ─── Supabase ───────────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. NEVER expose to the browser. Used for admin/moderation writes.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Roles ──────────────────────────────────────────────────
# The single main admin. Admin is granted ONLY to this email AND only
# once the email is verified. Enforced server-side, never from client state.
ADMIN_EMAIL=laythraadraheem@gmail.com

# ─── AI (Google Gemini) ────────────────────────────────────
# Server-side only. If unset, the moderation pipeline FAILS CLOSED and
# ATHAR AI / My Library AI answer in honest retrieval-only mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ─── ATHAR Web Intelligence (optional) ─────────────────────
# Any ONE of these enables live web search in ATHAR AI. Server-only keys.
# Provider selection: SEARCH_PROVIDER=tavily|brave|serper (default: first key found)
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_ATHAR_URL=../site/index.html
